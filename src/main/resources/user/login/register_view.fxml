<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.shape.Circle?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:id="rootPane"
            fx:controller="org.example.Controllers.user.login.RegisterController"
            prefWidth="1280" prefHeight="820"
            styleClass="login-root">

    <Pane AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0"
          AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
          styleClass="login-bg"/>
    <Circle radius="240" styleClass="blob blob-1"/>
    <Circle radius="180" styleClass="blob blob-2"/>
    <Circle radius="110" styleClass="blob blob-3"/>

    <StackPane AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0"
               AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
               alignment="CENTER" pickOnBounds="false">

        <HBox alignment="CENTER" maxWidth="1240" spacing="0" styleClass="main-container">

            <!-- ========== LEFT: HERO PANEL ========== -->
            <VBox alignment="CENTER" spacing="0" prefWidth="340"
                  styleClass="hero-panel" HBox.hgrow="NEVER">

                <VBox alignment="CENTER" spacing="10" styleClass="hero-logo-zone">
                    <StackPane styleClass="logo-glow-wrap" prefWidth="160" prefHeight="160"
                               maxWidth="160" maxHeight="160">
                        <Pane fx:id="logoGlow" styleClass="logo-glow-circle"/>
                        <ImageView fx:id="logoView" fitWidth="180" fitHeight="180"
                                   preserveRatio="true"/>
                    </StackPane>
                    <Text text="7anouti-E" styleClass="hero-title"/>
                    <Text text="Rejoignez la communaute" styleClass="hero-tagline"/>
                </VBox>

                <HBox alignment="CENTER" styleClass="hero-sep-wrap">
                    <Pane styleClass="hero-sep-line"/>
                    <Pane styleClass="hero-sep-dot"/>
                    <Pane styleClass="hero-sep-line"/>
                </HBox>

                <VBox spacing="14" styleClass="hero-features">
                    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="feature-row">
                        <StackPane styleClass="feature-badge"><Label text="1" styleClass="feature-badge-text"/></StackPane>
                        <Label text="Inscription rapide en 30 secondes" styleClass="feature-text"/>
                    </HBox>
                    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="feature-row">
                        <StackPane styleClass="feature-badge"><Label text="2" styleClass="feature-badge-text"/></StackPane>
                        <Label text="Acces immediat a toutes les fonctionnalites" styleClass="feature-text"/>
                    </HBox>
                    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="feature-row">
                        <StackPane styleClass="feature-badge"><Label text="3" styleClass="feature-badge-text"/></StackPane>
                        <Label text="Compte 100% securise et gratuit" styleClass="feature-text"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- ========== CENTER: FORM CARD ========== -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                        prefWidth="480" styleClass="register-scroll" HBox.hgrow="NEVER">
                <VBox fx:id="formCard" alignment="TOP_CENTER" spacing="10"
                      prefWidth="460" styleClass="login-card">

                    <VBox alignment="CENTER_LEFT" spacing="6" styleClass="card-header">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Pane styleClass="accent-bar accent-bar-green"/>
                            <Text text="Creer un compte" styleClass="card-welcome"/>
                        </HBox>
                        <Text text="Remplissez les informations ci-dessous" styleClass="card-subtitle"/>
                    </VBox>

                    <Label fx:id="errorLabel" text="" managed="false" visible="false"
                           wrapText="true" maxWidth="Infinity" styleClass="error-banner"/>
                    <Label fx:id="successLabel" text="" managed="false" visible="false"
                           wrapText="true" maxWidth="Infinity" styleClass="success-banner"/>

                    <!-- Photo de profil -->
                    <VBox alignment="CENTER" spacing="6" styleClass="field-group">
                        <StackPane fx:id="avatarContainer" styleClass="avatar-container"
                                   prefWidth="80" prefHeight="80" maxWidth="80" maxHeight="80">
                            <ImageView fx:id="avatarView" fitWidth="76" fitHeight="76"
                                       preserveRatio="false" styleClass="avatar-image"/>
                            <Label text="+" styleClass="avatar-plus"/>
                        </StackPane>
                        <Label text="Ajouter une photo" styleClass="avatar-label"/>
                    </VBox>

                    <!-- Nom + Prenom -->
                    <HBox spacing="10">
                        <VBox spacing="2" styleClass="field-group" HBox.hgrow="ALWAYS">
                            <Label text="NOM" styleClass="field-label"/>
                            <HBox alignment="CENTER_LEFT" styleClass="input-wrap">
                                <StackPane styleClass="input-icon-wrap">
                                    <Label text="N" styleClass="input-icon-text"/>
                                </StackPane>
                                <TextField fx:id="nameField" promptText="Nom"
                                           styleClass="text-input" HBox.hgrow="ALWAYS"/>
                            </HBox>
                            <Label fx:id="errNom" text="" managed="false" visible="false" styleClass="form-err-label"/>
                        </VBox>
                        <VBox spacing="2" styleClass="field-group" HBox.hgrow="ALWAYS">
                            <Label text="PRENOM" styleClass="field-label"/>
                            <HBox alignment="CENTER_LEFT" styleClass="input-wrap">
                                <StackPane styleClass="input-icon-wrap">
                                    <Label text="P" styleClass="input-icon-text"/>
                                </StackPane>
                                <TextField fx:id="prenomField" promptText="Prenom"
                                           styleClass="text-input" HBox.hgrow="ALWAYS"/>
                            </HBox>
                            <Label fx:id="errPrenom" text="" managed="false" visible="false" styleClass="form-err-label"/>
                        </VBox>
                    </HBox>

                    <!-- Date de naissance -->
                    <VBox spacing="2" styleClass="field-group">
                        <Label text="DATE DE NAISSANCE" styleClass="field-label"/>
                        <HBox alignment="CENTER_LEFT" styleClass="input-wrap">
                            <StackPane styleClass="input-icon-wrap">
                                <Label text="D" styleClass="input-icon-text"/>
                            </StackPane>
                            <DatePicker fx:id="dateNaissField" promptText="jj/mm/aaaa"
                                        styleClass="date-input" HBox.hgrow="ALWAYS"/>
                        </HBox>
                        <Label fx:id="errDate" text="" managed="false" visible="false" styleClass="form-err-label"/>
                    </VBox>

                    <!-- Email -->
                    <VBox spacing="2" styleClass="field-group">
                        <Label text="EMAIL" styleClass="field-label"/>
                        <HBox alignment="CENTER_LEFT" styleClass="input-wrap">
                            <StackPane styleClass="input-icon-wrap">
                                <Label fx:id="emailIcon" text="E" styleClass="input-icon-text"/>
                            </StackPane>
                            <TextField fx:id="emailField" promptText="votre email"
                                       styleClass="text-input" HBox.hgrow="ALWAYS"/>
                            <Pane fx:id="emailStatus" styleClass="input-status" managed="false" visible="false"/>
                        </HBox>
                        <Label fx:id="errEmail" text="" managed="false" visible="false" styleClass="form-err-label"/>
                    </VBox>

                    <!-- Telephone -->
                    <VBox spacing="2" styleClass="field-group">
                        <Label text="TELEPHONE" styleClass="field-label"/>
                        <HBox alignment="CENTER_LEFT" styleClass="input-wrap">
                            <StackPane styleClass="input-icon-wrap">
                                <Label text="T" styleClass="input-icon-text"/>
                            </StackPane>
                            <TextField fx:id="numTelField" promptText="+216 XX XXX XXX"
                                       styleClass="text-input" HBox.hgrow="ALWAYS"/>

                            <Label fx:id="countryLabel"
                                   text=""
                                   managed="false"
                                   visible="false"
                                   styleClass="country-badge"/>
                        </HBox>
                        <Label fx:id="errTel" text="" managed="false" visible="false" styleClass="form-err-label"/>
                    </VBox>

                    <VBox spacing="2" styleClass="field-group">
                        <Label text="ADRESSE" styleClass="field-label"/>
                        <HBox alignment="CENTER_LEFT" styleClass="input-wrap">
                            <StackPane styleClass="input-icon-wrap">
                                <Label text="A" styleClass="input-icon-text"/>
                            </StackPane>
                            <TextField fx:id="adresseField"
                                       promptText="Votre adresse"
                                       styleClass="text-input"
                                       HBox.hgrow="ALWAYS"/>
                        </HBox>
                    </VBox>

                    <!-- Mot de passe -->
                    <VBox spacing="2" styleClass="field-group">
                        <Label text="MOT DE PASSE" styleClass="field-label"/>
                        <HBox alignment="CENTER_LEFT" styleClass="input-wrap">
                            <StackPane styleClass="input-icon-wrap">
                                <Label text="*" styleClass="input-icon-text"/>
                            </StackPane>
                            <StackPane HBox.hgrow="ALWAYS">
                                <PasswordField fx:id="passwordField" promptText="Min. 8 caracteres"
                                               styleClass="text-input"/>
                                <TextField fx:id="passwordVisibleField" promptText="Min. 8 caracteres"
                                           styleClass="text-input" visible="false" managed="false"/>
                            </StackPane>
                            <ToggleButton fx:id="showPasswordBtn" text="o"
                                          focusTraversable="false" styleClass="eye-toggle"/>
                        </HBox>
                        <HBox spacing="4" styleClass="strength-row">
                            <Pane fx:id="str1" styleClass="strength-seg" HBox.hgrow="ALWAYS"/>
                            <Pane fx:id="str2" styleClass="strength-seg" HBox.hgrow="ALWAYS"/>
                            <Pane fx:id="str3" styleClass="strength-seg" HBox.hgrow="ALWAYS"/>
                            <Pane fx:id="str4" styleClass="strength-seg" HBox.hgrow="ALWAYS"/>
                        </HBox>
                        <Label fx:id="strengthLabel" text="" styleClass="strength-text"
                               managed="false" visible="false"/>
                        <Label fx:id="errPass" text="" managed="false" visible="false" styleClass="form-err-label"/>
                    </VBox>

                    <!-- Confirmer mot de passe -->
                    <VBox spacing="2" styleClass="field-group">
                        <Label text="CONFIRMER MOT DE PASSE" styleClass="field-label"/>
                        <HBox alignment="CENTER_LEFT" styleClass="input-wrap">
                            <StackPane styleClass="input-icon-wrap">
                                <Label text="*" styleClass="input-icon-text"/>
                            </StackPane>
                            <PasswordField fx:id="confirmPasswordField" promptText="Retapez le mot de passe"
                                           styleClass="text-input" HBox.hgrow="ALWAYS"/>
                            <Pane fx:id="matchStatus" styleClass="input-status" managed="false" visible="false"/>
                        </HBox>
                        <Label fx:id="errConfirm" text="" managed="false" visible="false" styleClass="form-err-label"/>
                    </VBox>

                    <!-- Register button -->
                    <StackPane styleClass="btn-wrap">
                        <Button fx:id="registerBtn" text="Creer mon compte"
                                maxWidth="Infinity" styleClass="login-btn register-btn"/>
                    </StackPane>
                    <CheckBox fx:id="faceIdCheck"
                              text="Activer Face ID"
                              styleClass="remember-check"/>

                    <!-- Divider -->
                    <HBox alignment="CENTER" spacing="14" styleClass="divider-row">
                        <Pane styleClass="divider-line" HBox.hgrow="ALWAYS"/>
                        <Label text="ou" styleClass="divider-label"/>
                        <Pane styleClass="divider-line" HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <!-- Login link -->
                    <HBox alignment="CENTER" spacing="4" styleClass="signup-row">
                        <Label text="Vous avez deja un compte ?" styleClass="signup-text"/>
                        <Hyperlink fx:id="loginLink" text="Se connecter" styleClass="signup-link"/>
                    </HBox>

                    <HBox alignment="CENTER" styleClass="card-footer">
                        <Text text="7anouti-E 2026 - Tous droits reserves" styleClass="footer-text"/>
                    </HBox>
                </VBox>
            </ScrollPane>

            <!-- ========== RIGHT: LIVE PREVIEW CARD ========== -->
            <VBox fx:id="previewCard" alignment="TOP_CENTER" spacing="0"
                  prefWidth="280" styleClass="preview-card" HBox.hgrow="NEVER">

                <!-- Header preview -->
                <VBox alignment="CENTER" spacing="4" styleClass="preview-header">
                    <Label text="APERCU EN TEMPS REEL" styleClass="preview-header-title"/>
                    <Label text="Votre profil tel qu'il apparaitra" styleClass="preview-header-sub"/>
                </VBox>

                <!-- Avatar preview -->
                <VBox alignment="CENTER" spacing="8" styleClass="preview-avatar-zone">
                    <StackPane prefWidth="90" prefHeight="90" maxWidth="90" maxHeight="90"
                               styleClass="preview-avatar-wrap">
                        <ImageView fx:id="previewAvatarImg" fitWidth="86" fitHeight="86"
                                   preserveRatio="false"/>
                        <Label fx:id="previewAvatarLetter" text="?" styleClass="preview-avatar-letter"/>
                    </StackPane>
                    <Label fx:id="previewFullName" text="Votre nom" styleClass="preview-name"/>
                    <Label fx:id="previewRole" text="Acheteur" styleClass="preview-role-badge"/>
                </VBox>

                <!-- Separateur -->
                <Pane styleClass="preview-sep"/>

                <!-- Infos ligne par ligne -->
                <VBox spacing="0" styleClass="preview-fields">

                    <!-- Email -->
                    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="preview-row">
                        <StackPane styleClass="preview-row-icon">
                            <Label text="E" styleClass="preview-row-icon-text"/>
                        </StackPane>
                        <VBox spacing="1">
                            <Label text="EMAIL" styleClass="preview-row-label"/>
                            <Label fx:id="previewEmail" text="—" styleClass="preview-row-value"/>
                        </VBox>
                    </HBox>

                    <!-- Telephone -->
                    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="preview-row">
                        <StackPane styleClass="preview-row-icon">
                            <Label text="T" styleClass="preview-row-icon-text"/>
                        </StackPane>
                        <VBox spacing="1">
                            <Label text="TELEPHONE" styleClass="preview-row-label"/>
                            <Label fx:id="previewTel" text="—" styleClass="preview-row-value"/>
                        </VBox>
                    </HBox>

                    <!-- Date naissance -->
                    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="preview-row">
                        <StackPane styleClass="preview-row-icon">
                            <Label text="D" styleClass="preview-row-icon-text"/>
                        </StackPane>
                        <VBox spacing="1">
                            <Label text="DATE DE NAISSANCE" styleClass="preview-row-label"/>
                            <Label fx:id="previewDate" text="—" styleClass="preview-row-value"/>
                        </VBox>
                    </HBox>

                    <!-- Mot de passe (masque) -->
                    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="preview-row">
                        <StackPane styleClass="preview-row-icon">
                            <Label text="*" styleClass="preview-row-icon-text"/>
                        </StackPane>
                        <VBox spacing="1">
                            <Label text="MOT DE PASSE" styleClass="preview-row-label"/>
                            <Label fx:id="previewPass" text="—" styleClass="preview-row-value"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Separateur -->
                <Pane styleClass="preview-sep"/>

                <!-- Progress: champs remplis -->
                <VBox spacing="8" styleClass="preview-progress-zone">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="Completion" styleClass="preview-progress-label"/>
                        <Label fx:id="previewPercent" text="0%" styleClass="preview-progress-percent"/>
                    </HBox>
                    <StackPane styleClass="preview-progress-track">
                        <Pane fx:id="previewProgressBar" styleClass="preview-progress-fill"
                              prefHeight="6" maxHeight="6"/>
                    </StackPane>
                    <Label fx:id="previewProgressText" text="Remplissez les champs pour continuer"
                           styleClass="preview-progress-hint" wrapText="true"/>
                </VBox>

                <!-- Checklist champs -->
                <VBox spacing="6" styleClass="preview-checklist">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label fx:id="chkNom"    text="O" styleClass="chk-icon chk-empty"/>
                        <Label text="Nom et Prenom"       styleClass="chk-label"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label fx:id="chkDate"   text="O" styleClass="chk-icon chk-empty"/>
                        <Label text="Date de naissance"   styleClass="chk-label"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label fx:id="chkEmail"  text="O" styleClass="chk-icon chk-empty"/>
                        <Label text="Email valide"         styleClass="chk-label"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label fx:id="chkTel"    text="O" styleClass="chk-icon chk-empty"/>
                        <Label text="Telephone"            styleClass="chk-label"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label fx:id="chkPass"   text="O" styleClass="chk-icon chk-empty"/>
                        <Label text="Mot de passe (8+)"   styleClass="chk-label"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label fx:id="chkConfirm" text="O" styleClass="chk-icon chk-empty"/>
                        <Label text="Mots de passe identiques" styleClass="chk-label"/>
                    </HBox>
                </VBox>

            </VBox>

        </HBox>
    </StackPane>

    <HBox AnchorPane.topAnchor="18" AnchorPane.rightAnchor="18"
          alignment="CENTER" styleClass="theme-toggle-wrap">
        <ToggleButton fx:id="themeToggleBtn" text="theme" styleClass="theme-toggle-btn"/>
    </HBox>

</AnchorPane>
