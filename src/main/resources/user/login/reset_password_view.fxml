<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.shape.Circle?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:id="rootPane"
            fx:controller="org.example.Controllers.user.login.ResetPasswordController"
            prefWidth="1100" prefHeight="700"
            styleClass="login-root">

    <Pane AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0"
          AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
          styleClass="login-bg"/>

    <Circle radius="200" styleClass="blob blob-1"/>
    <Circle radius="140" styleClass="blob blob-2"/>

    <StackPane AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0"
               AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
               alignment="CENTER" pickOnBounds="false">

        <VBox fx:id="formCard" alignment="CENTER" spacing="20"
              maxWidth="480" prefWidth="480" styleClass="forgot-card">

            <VBox alignment="CENTER" spacing="8">
                <StackPane styleClass="logo-glow-wrap" prefWidth="120" prefHeight="120"
                           maxWidth="120" maxHeight="120">
                    <Pane fx:id="logoGlow" styleClass="logo-glow-circle-small"/>
                    <ImageView fx:id="logoView" fitWidth="130" fitHeight="130"
                               preserveRatio="true"/>
                </StackPane>
                <Text text="7anouti-E" styleClass="forgot-brand"/>
            </VBox>

            <VBox alignment="CENTER" spacing="6" styleClass="forgot-header">
                <Text text="Nouveau mot de passe" styleClass="forgot-title"/>
                <Text text="Choisissez un nouveau mot de passe sécurisé"
                      styleClass="forgot-desc"/>
            </VBox>

            <Label fx:id="errorLabel" text="" managed="false" visible="false"
                   wrapText="true" maxWidth="Infinity" styleClass="error-banner"/>

            <Label fx:id="successLabel" text="" managed="false" visible="false"
                   wrapText="true" maxWidth="Infinity" styleClass="success-banner"/>

            <Label fx:id="emailLabel" text="" styleClass="field-label"/>

            <VBox spacing="8" styleClass="field-group">
            <Label text="NOUVEAU MOT DE PASSE" styleClass="field-label"/>

            <HBox alignment="CENTER_LEFT" styleClass="input-wrap">
                <StackPane styleClass="input-icon-wrap">
                    <Label text="🔒" styleClass="input-icon-text"/>
                </StackPane>

                <PasswordField fx:id="passwordField"
                               promptText="Min. 8 caracteres"
                               styleClass="text-input"
                               HBox.hgrow="ALWAYS"/>

                <TextField fx:id="passwordVisibleField"
                           promptText="Min. 8 caracteres"
                           styleClass="text-input"
                           managed="false"
                           visible="false"
                           HBox.hgrow="ALWAYS"/>

                <ToggleButton fx:id="showPasswordBtn"
                              text="👁"
                              styleClass="show-pass-btn"/>
            </HBox>

            <HBox spacing="5" alignment="CENTER_LEFT">
                <Pane fx:id="str1" prefHeight="5" prefWidth="70"/>
                <Pane fx:id="str2" prefHeight="5" prefWidth="70"/>
                <Pane fx:id="str3" prefHeight="5" prefWidth="70"/>
                <Pane fx:id="str4" prefHeight="5" prefWidth="70"/>
                <Label fx:id="strengthLabel" managed="false" visible="false"/>
            </HBox>

            <Label fx:id="errPass" managed="false" visible="false"
                   styleClass="field-error"/>
        </VBox>

            <VBox spacing="8" styleClass="field-group">
                <Label text="CONFIRMER MOT DE PASSE" styleClass="field-label"/>
                <HBox alignment="CENTER_LEFT" styleClass="input-wrap">
                    <StackPane styleClass="input-icon-wrap">
                        <Label text="✓" styleClass="input-icon-text"/>
                    </StackPane>
                    <PasswordField fx:id="confirmPasswordField"
                                   promptText="Retapez le mot de passe"
                                   styleClass="text-input"
                                   HBox.hgrow="ALWAYS"/>
                </HBox>
                <Label fx:id="errConfirm" managed="false" visible="false"
                       styleClass="field-error"/>
            </VBox>

            <StackPane styleClass="btn-wrap">
                <Button fx:id="resetBtn"
                        text="Changer le mot de passe"
                        maxWidth="Infinity"
                        styleClass="login-btn forgot-btn"/>
            </StackPane>

            <HBox alignment="CENTER" spacing="4" styleClass="signup-row">
                <Hyperlink fx:id="backLink" text="Retour à la connexion"
                           styleClass="signup-link"/>
            </HBox>

            <HBox alignment="CENTER" styleClass="card-footer">
                <Text text="7anouti-E 2026" styleClass="footer-text"/>
            </HBox>
        </VBox>
    </StackPane>

    <HBox AnchorPane.topAnchor="18" AnchorPane.rightAnchor="18"
          alignment="CENTER" styleClass="theme-toggle-wrap">
        <ToggleButton fx:id="themeToggleBtn" text="theme" styleClass="theme-toggle-btn"/>
    </HBox>

</AnchorPane>