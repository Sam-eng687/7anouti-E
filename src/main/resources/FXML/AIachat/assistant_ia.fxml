<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox fx:id="rootPane"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="projet.hanouti.AIachat.controllers.AssistantIAController"
      prefWidth="1100" prefHeight="720"
      styleClass="assistant-root"
      stylesheets="@../../styles/AIachat/assistant-theme.css">
    <!-- ═══════════════════════════════════════════════════════════════════
         MAIN CONTENT
         ═══════════════════════════════════════════════════════════════════ -->
    <VBox fx:id="rootVBox" HBox.hgrow="ALWAYS">

        <!-- CONTEXT BAR -->
        <Label fx:id="contextLabel" styleClass="ctx-bar"
               text="●  Bonjour ! Décrivez votre besoin ci-dessous."
               maxWidth="Infinity"/>

        <!-- STACK PANE - single vertical scroll, no horizontal scroll anywhere -->
        <StackPane fx:id="mainArea" VBox.vgrow="ALWAYS">

            <ScrollPane fx:id="mainScroll" styleClass="main-scroll"
                        fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                <VBox fx:id="mainContent" spacing="0">

                    <Label fx:id="welcomeLabel" styleClass="welcome-label"
                           text="Que recherchez-vous aujourd'hui ?" style="-fx-padding:24 8 16 8;"/>

                    <!-- IDLE SECTIONS -->
                    <VBox fx:id="idleSections" spacing="14"
                          style="-fx-padding:0 20 0 20;">

                        <!-- ── LAST PURCHASES section ───────────────────── -->
                        <VBox styleClass="section-container">
                            <HBox styleClass="section-head" alignment="CENTER_LEFT">
                                <Label styleClass="section-title" text="● D'après vos dernières recherches"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="showMoreLastBtn" styleClass="show-more-btn"
                                        text="Afficher plus ↓" onAction="#toggleLastExpand"/>
                            </HBox>

                            <!-- Row 1 - always visible. 6 cards × 134 px + 5 × 10 px gaps
                                 + 16 px padding each side = 858 px ← fits in 890 px available.
                                 No scroll pane of any kind. -->
                            <HBox fx:id="lastRow1" spacing="10"
                                  style="-fx-padding:8 16 8 16;"/>

                            <!-- Expand rows - revealed by Show more, drop straight down.
                                 mainScroll is the only scrollable element. -->
                            <VBox fx:id="lastExpandRows" visible="false" managed="false" spacing="0">
                                <HBox fx:id="lastRow2" spacing="10"
                                      style="-fx-padding:0 16 8 16;"/>
                                <HBox fx:id="lastRow3" spacing="10"
                                      style="-fx-padding:0 16 8 16;"/>
                            </VBox>
                        </VBox>

                        <Region styleClass="section-sep"/>

                        <!-- ── TOP RATED section ────────────────────────── -->
                        <VBox styleClass="section-container">
                            <HBox styleClass="section-head" alignment="CENTER_LEFT">
                                <Label styleClass="section-title" text="● Produits les mieux notés"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="showMoreTopBtn" styleClass="show-more-btn"
                                        text="Afficher plus ↓" onAction="#toggleTopExpand"/>
                            </HBox>

                            <HBox fx:id="topRow1" spacing="10"
                                  style="-fx-padding:8 16 8 16;"/>

                            <VBox fx:id="topExpandRows" visible="false" managed="false" spacing="0">
                                <HBox fx:id="topRow2" spacing="10"
                                      style="-fx-padding:0 16 8 16;"/>
                                <HBox fx:id="topRow3" spacing="10"
                                      style="-fx-padding:0 16 8 16;"/>
                            </VBox>
                        </VBox>

                        <Region styleClass="section-sep"/>

                        <!-- Discounts & Offers section - same row layout as other sections -->
                        <VBox fx:id="offersSection" styleClass="section-container" style="-fx-padding:0 0 6 0;">
                            <HBox styleClass="section-head" alignment="CENTER_LEFT">
                                <Label styleClass="section-title" text="● Réductions &amp; Offres"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="showMoreOffersBtn" styleClass="show-more-btn"
                                        text="Afficher plus ↓" onAction="#toggleOffersExpand"
                                        visible="false" managed="false"/>
                            </HBox>
                            <!-- Shown when no active offers are available -->
                            <VBox fx:id="offersPlaceholder"
                                  styleClass="discount-placeholder" alignment="CENTER"
                                  spacing="8" prefHeight="130">
                                <VBox.margin><Insets left="28" right="28"/></VBox.margin>
                                <Label styleClass="discount-placeholder-icon" text="🏷"/>
                                <Label styleClass="discount-placeholder-text"
                                       text="Promotions et offres spéciales bientôt disponibles."/>
                                <Label styleClass="discount-placeholder-badge" text="Bientôt disponible"/>
                            </VBox>
                            <!-- Row 1 - always visible -->
                            <HBox fx:id="offerRow1" spacing="10"
                                  style="-fx-padding:8 16 8 16;"/>
                            <!-- Expand rows - revealed by Show more -->
                            <VBox fx:id="offerExpandRows" visible="false" managed="false" spacing="0">
                                <HBox fx:id="offerRow2" spacing="10"
                                      style="-fx-padding:0 16 8 16;"/>
                                <HBox fx:id="offerRow3" spacing="10"
                                      style="-fx-padding:0 16 8 16;"/>
                            </VBox>
                        </VBox>

                    </VBox>

                    <!-- Bottom padding - prevents floating bar from covering last row of cards -->
                    <Region prefHeight="110" minHeight="110" managed="true" visible="true"/>

                    <!-- CHAT BUBBLES -->
                    <VBox fx:id="chatSection" visible="false" managed="false">
                        <VBox fx:id="chatBubbleBox" spacing="10"
                              style="-fx-padding:20 24 20 24;"/>
                    </VBox>

                    <!-- RESULTS - also a FlowPane so result cards wrap vertically -->
                    <VBox fx:id="resultsSection" visible="false" managed="false">
                        <HBox styleClass="results-head" alignment="CENTER_LEFT" spacing="10">
                            <Label styleClass="results-title" text="Résultats de recherche"/>
                            <Label fx:id="resultsCountLabel" styleClass="results-count" text=""/>
                            <Region HBox.hgrow="ALWAYS"/>
                        </HBox>
                        <HBox fx:id="resultToolbarBox" styleClass="result-toolbar"
                              alignment="CENTER_LEFT" spacing="8"/>
                        <!--
                            Result cards: FlowPane wraps to as many rows as needed.
                            No horizontal scroll - mainScroll handles vertical movement.
                        -->
                        <FlowPane fx:id="resultCardsBox"
                                  hgap="14" vgap="14"
                                  style="-fx-padding:8 28 20 28;"/>
                    </VBox>

                </VBox>
            </ScrollPane>

            <!-- FLOATING BAR -->
            <HBox fx:id="floatingBar"
                  styleClass="floating-bar"
                  StackPane.alignment="BOTTOM_CENTER"
                  alignment="CENTER_LEFT" spacing="0"
                  maxHeight="58" prefHeight="58"
                  visible="false" managed="false">
                <StackPane.margin>
                    <Insets bottom="24" left="120" right="120"/>
                </StackPane.margin>
                <TextField fx:id="floatingInput"
                           styleClass="floating-input"
                           promptText="✦  Demandez à l'IA : que recherchez-vous ?"
                           onAction="#handleFloatingSubmit"
                           HBox.hgrow="ALWAYS"/>
                <Button fx:id="floatingMicBtn"
                        styleClass="mic-btn"
                        text=""
                        onAction="#handleMicBtn"
                        style="-fx-min-width:42;-fx-max-width:42;-fx-min-height:42;-fx-max-height:42;"/>

                <Button fx:id="floatingCameraBtn"
                        styleClass="camera-btn"
                        text=""
                        onAction="#handleCameraBtn"
                        style="-fx-min-width:42;-fx-max-width:42;-fx-min-height:42;-fx-max-height:42;"/>

                <Button fx:id="floatingSendBtn"
                        styleClass="floating-send-btn"
                        text="" onAction="#handleFloatingSubmit"/>
            </HBox>

        </StackPane>

        <!-- CHAT BAR -->
        <HBox fx:id="chatBarHBox" styleClass="chat-bar"
              alignment="CENTER_LEFT" spacing="10"
              visible="false" managed="false">

            <Label fx:id="stateBadge" styleClass="state-badge" text="IDLE"/>

            <ProgressIndicator fx:id="progressIndicator"
                               prefWidth="22" prefHeight="22"
                               visible="false"
                               style="-fx-progress-color:#14B8A6;"/>

            <TextField fx:id="inputField" styleClass="chat-input"
                       promptText="Ex : médicament pour la fièvre…"
                       onAction="#handleSend" HBox.hgrow="ALWAYS"/>

            <Button fx:id="chatMicBtn"
                    styleClass="mic-btn"
                    text=""
                    onAction="#handleMicBtn"
                    style="-fx-min-width:42;-fx-max-width:42;-fx-min-height:42;-fx-max-height:42;"/>

            <Button fx:id="chatCameraBtn"
                    styleClass="camera-btn"
                    text=""
                    onAction="#handleCameraBtn"
                    style="-fx-min-width:42;-fx-max-width:42;-fx-min-height:42;-fx-max-height:42;"/>

            <Button styleClass="reset-btn" text="Recommencer" onAction="#handleReset"/>

            <Button fx:id="sendButton" styleClass="send-btn" text="" onAction="#handleSend"/>

        </HBox>

    </VBox>

</HBox>


