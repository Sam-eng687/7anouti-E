<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.shape.Circle?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:id="rootPane"
            fx:controller="projet.hanouti.user_auth.controllers.front.HomeController"
            prefWidth="1400" prefHeight="860"
            styleClass="front-root">

    <Pane styleClass="front-bg"
          AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0"
          AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"/>

    <Circle radius="340" styleClass="front-blob front-blob-1"/>
    <Circle radius="220" styleClass="front-blob front-blob-2"/>
    <Circle radius="160" styleClass="front-blob front-blob-3"/>

    <VBox AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0"
          AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0">

        <!-- ========== TOP NAVBAR ========== -->
        <HBox fx:id="topNav" styleClass="topnav" alignment="CENTER_LEFT" spacing="0">

            <!-- Logo zone -->
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="topnav-logo-zone">
                <StackPane prefWidth="52" prefHeight="52" maxWidth="52" maxHeight="52"
                           styleClass="topnav-logo-box">
                    <ImageView fx:id="navLogo" fitWidth="44" fitHeight="44" preserveRatio="true"/>
                    <Label fx:id="navLogoText" text="7E" styleClass="topnav-logo-fallback"/>
                </StackPane>
                <VBox spacing="1">
                    <Label text="7anouti-E" styleClass="topnav-app-name"/>
                    <Label text="Espace Acheteur" styleClass="topnav-app-sub"/>
                </VBox>
            </HBox>

            <!-- Separateur vertical -->
            <Pane styleClass="topnav-vsep"/>

            <!-- Nav links -->
            <HBox fx:id="navLinksBox" alignment="CENTER_LEFT" spacing="2" HBox.hgrow="ALWAYS"
                  styleClass="topnav-links">
                <Button fx:id="navHome" text="Accueil" styleClass="topnav-item topnav-active"/>
                <Button fx:id="navModule1" text="Module 1" styleClass="topnav-item"/>
                <Button fx:id="navModule2" text="Module 2" styleClass="topnav-item"/>
                <Button fx:id="navModule3" text="Module 3" styleClass="topnav-item"/>
                <Button fx:id="navModule4" text="Module 4" styleClass="topnav-item"/>
                <Button fx:id="navModule5" text="Module 5" styleClass="topnav-item"/>
                <Button fx:id="navModule6" text="Module 6" styleClass="topnav-item"/>
            </HBox>

            <!-- Right: theme + logout + avatar -->
            <HBox alignment="CENTER_RIGHT" spacing="12" styleClass="topnav-right">
                <Button fx:id="themeBtn" styleClass="topnav-theme-btn">
                    <graphic>
                        <HBox spacing="6" alignment="CENTER">
                            <Label fx:id="themeIcon" text="L" styleClass="topnav-theme-icon"/>
                            <Label fx:id="themeLabel" text="Jour" styleClass="topnav-theme-label"/>
                        </HBox>
                    </graphic>
                </Button>
                <Button fx:id="logoutBtn" styleClass="topnav-logout-btn" text="Deconnexion"/>
                <!-- Avatar chip -->
                <Button fx:id="avatarBtn" styleClass="topnav-avatar-chip">
                    <graphic>
                        <HBox spacing="10" alignment="CENTER">
                            <StackPane prefWidth="38" prefHeight="38" maxWidth="38" maxHeight="38"
                                       styleClass="topnav-avatar-circle">
                                <ImageView fx:id="userAvatar" fitWidth="34" fitHeight="34" preserveRatio="false"/>
                                <Label fx:id="userAvatarLetter" text="A" styleClass="topnav-avatar-letter"/>
                            </StackPane>
                            <VBox spacing="1">
                                <Label fx:id="userNameLabel" text="Utilisateur" styleClass="topnav-user-name"/>
                                <Label fx:id="userRoleLabel" text="acheteur" styleClass="topnav-user-role"/>
                            </VBox>
                        </HBox>
                    </graphic>
                </Button>
            </HBox>
        </HBox>

        <!-- ========== CONTENT ========== -->
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    styleClass="front-scroll" VBox.vgrow="ALWAYS">
            <VBox spacing="20" styleClass="front-content">

                <!-- HERO BANNER -->
                <HBox styleClass="front-hero-banner" alignment="CENTER_LEFT" spacing="0">
                    <VBox spacing="12" HBox.hgrow="ALWAYS" styleClass="front-hero-text">
                        <Label fx:id="heroGreeting" text="Bonjour !" styleClass="front-hero-greeting"/>
                        <Label text="Decouvrez tout ce que 7anouti-E a a offrir"
                               styleClass="front-hero-desc"/>
                        <HBox spacing="12">
                            <Button fx:id="heroCta1" text="Explorer" styleClass="front-hero-btn-primary"/>
                            <Button fx:id="heroCta2" text="Mon Profil" styleClass="front-hero-btn-secondary"/>
                        </HBox>
                    </VBox>
                    <Label text="7E" styleClass="front-hero-badge"/>
                </HBox>

                <!-- STATS ROW -->
                <HBox spacing="14">
                    <VBox styleClass="front-stat-card" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <StackPane styleClass="front-stat-icon-wrap front-stat-icon-indigo">
                                <Label text="M" styleClass="front-stat-icon-text"/>
                            </StackPane>
                            <VBox spacing="2">
                                <Label text="Modules disponibles" styleClass="front-stat-label"/>
                                <Label text="6" styleClass="front-stat-value"/>
                            </VBox>
                        </HBox>
                    </VBox>
                    <VBox styleClass="front-stat-card" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <StackPane styleClass="front-stat-icon-wrap front-stat-icon-green">
                                <Label text="S" styleClass="front-stat-icon-text"/>
                            </StackPane>
                            <VBox spacing="2">
                                <Label text="Statut du compte" styleClass="front-stat-label"/>
                                <Label text="Actif" styleClass="front-stat-value front-stat-green-val"/>
                            </VBox>
                        </HBox>
                    </VBox>
                    <VBox styleClass="front-stat-card" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <StackPane styleClass="front-stat-icon-wrap front-stat-icon-amber">
                                <Label text="R" styleClass="front-stat-icon-text"/>
                            </StackPane>
                            <VBox spacing="2">
                                <Label text="Role" styleClass="front-stat-label"/>
                                <Label fx:id="statRoleLabel" text="Acheteur" styleClass="front-stat-value"/>
                            </VBox>
                        </HBox>
                    </VBox>
                    <VBox styleClass="front-stat-card" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <StackPane styleClass="front-stat-icon-wrap front-stat-icon-purple">
                                <Label text="P" styleClass="front-stat-icon-text"/>
                            </StackPane>
                            <VBox spacing="2">
                                <Label text="Mon Profil" styleClass="front-stat-label"/>
                                <Button fx:id="profileShortcut" text="Acceder"
                                        styleClass="front-stat-link-btn"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- MODULES GRID — 6 en 1 ligne -->
                <VBox spacing="12">
                    <Label text="Modules" styleClass="front-section-title"/>
                    <HBox spacing="14">
                        <VBox fx:id="card1" styleClass="front-module-card front-module-1" HBox.hgrow="ALWAYS">
                            <StackPane styleClass="front-module-icon-wrap">
                                <Label text="1" styleClass="front-module-icon"/>
                            </StackPane>
                            <Label text="Module 1" styleClass="front-module-title"/>
                            <Label text="Bientot disponible" styleClass="front-module-desc" wrapText="true"/>
                            <Button text="Acceder" styleClass="front-module-btn"/>
                        </VBox>
                        <VBox fx:id="card2" styleClass="front-module-card front-module-2" HBox.hgrow="ALWAYS">
                            <StackPane styleClass="front-module-icon-wrap">
                                <Label text="2" styleClass="front-module-icon"/>
                            </StackPane>
                            <Label text="Module 2" styleClass="front-module-title"/>
                            <Label text="Bientot disponible" styleClass="front-module-desc" wrapText="true"/>
                            <Button text="Acceder" styleClass="front-module-btn"/>
                        </VBox>
                        <VBox fx:id="card3" styleClass="front-module-card front-module-3" HBox.hgrow="ALWAYS">
                            <StackPane styleClass="front-module-icon-wrap">
                                <Label text="3" styleClass="front-module-icon"/>
                            </StackPane>
                            <Label text="Module 3" styleClass="front-module-title"/>
                            <Label text="Bientot disponible" styleClass="front-module-desc" wrapText="true"/>
                            <Button text="Acceder" styleClass="front-module-btn"/>
                        </VBox>
                        <VBox fx:id="card4" styleClass="front-module-card front-module-4" HBox.hgrow="ALWAYS">
                            <StackPane styleClass="front-module-icon-wrap">
                                <Label text="4" styleClass="front-module-icon"/>
                            </StackPane>
                            <Label text="Module 4" styleClass="front-module-title"/>
                            <Label text="Bientot disponible" styleClass="front-module-desc" wrapText="true"/>
                            <Button text="Acceder" styleClass="front-module-btn"/>
                        </VBox>
                        <VBox fx:id="card5" styleClass="front-module-card front-module-5" HBox.hgrow="ALWAYS">
                            <StackPane styleClass="front-module-icon-wrap">
                                <Label text="5" styleClass="front-module-icon"/>
                            </StackPane>
                            <Label text="Module 5" styleClass="front-module-title"/>
                            <Label text="Bientot disponible" styleClass="front-module-desc" wrapText="true"/>
                            <Button text="Acceder" styleClass="front-module-btn"/>
                        </VBox>
                        <VBox fx:id="card6" styleClass="front-module-card front-module-6" HBox.hgrow="ALWAYS">
                            <StackPane styleClass="front-module-icon-wrap">
                                <Label text="6" styleClass="front-module-icon"/>
                            </StackPane>
                            <Label text="Module 6" styleClass="front-module-title"/>
                            <Label text="Bientot disponible" styleClass="front-module-desc" wrapText="true"/>
                            <Button text="Acceder" styleClass="front-module-btn"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- FOOTER -->
                <HBox alignment="CENTER" styleClass="front-footer">
                    <Label text="7anouti-E 2026 — Tous droits reserves" styleClass="front-footer-text"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </VBox>
</AnchorPane>
