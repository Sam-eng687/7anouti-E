<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:id="rootPane"
            fx:controller="projet.hanouti.user_auth.controllers.back.DashboardController"
            prefWidth="1400" prefHeight="860"
            styleClass="dash-root">

    <Pane styleClass="dash-bg" AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0"
          AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"/>

    <HBox AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0"
          AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0">

        <VBox fx:id="sidebar" styleClass="sidebar" prefWidth="260" minWidth="260" maxWidth="260" spacing="0">
            <VBox alignment="CENTER" spacing="10" styleClass="sidebar-logo-zone">
                <StackPane prefWidth="120" prefHeight="120" maxWidth="120" maxHeight="120"
                           styleClass="sidebar-logo-wrap">
                    <ImageView fx:id="sidebarLogo" fitWidth="110" fitHeight="110" preserveRatio="true"/>
                </StackPane>
                <Label text="7anouti-E" styleClass="sidebar-app-name"/>
            </VBox>

            <Pane styleClass="sidebar-sep"/>

            <Label text="NAVIGATION" styleClass="sidebar-section-label">
                <VBox.margin><Insets left="20" top="12" bottom="4"/></VBox.margin>
            </Label>

            <VBox fx:id="navContainer" alignment="TOP_LEFT" spacing="4"
                  styleClass="sidebar-nav" VBox.vgrow="ALWAYS">

                <Button fx:id="navUsers" styleClass="nav-btn" maxWidth="Infinity" alignment="BASELINE_LEFT">
                    <graphic>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label text="Dashboard" styleClass="nav-label"/>
                        </HBox>
                    </graphic>
                    <tooltip><Tooltip text="Dashboard"/></tooltip>
                </Button>

                <Button fx:id="navProducts" styleClass="nav-btn" maxWidth="Infinity" alignment="BASELINE_LEFT">
                    <graphic>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label text="Module 2" styleClass="nav-label"/>
                        </HBox>
                    </graphic>
                    <tooltip><Tooltip text="Module 2"/></tooltip>
                </Button>

                <Button fx:id="navOrders" styleClass="nav-btn" maxWidth="Infinity" alignment="BASELINE_LEFT">
                    <graphic>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label text="Module 3" styleClass="nav-label"/>
                        </HBox>
                    </graphic>
                    <tooltip><Tooltip text="Module 3"/></tooltip>
                </Button>

                <Button fx:id="navStats" styleClass="nav-btn" maxWidth="Infinity" alignment="BASELINE_LEFT">
                    <graphic>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label text="Module 4" styleClass="nav-label"/>
                        </HBox>
                    </graphic>
                    <tooltip><Tooltip text="Module 4"/></tooltip>
                </Button>

                <Button fx:id="navSettings" styleClass="nav-btn" maxWidth="Infinity" alignment="BASELINE_LEFT">
                    <graphic>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label text="Module 5" styleClass="nav-label"/>
                        </HBox>
                    </graphic>
                    <tooltip><Tooltip text="Module 5"/></tooltip>
                </Button>

                <Button fx:id="navSupport" styleClass="nav-btn" maxWidth="Infinity" alignment="BASELINE_LEFT">
                    <graphic>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label text="Module 6" styleClass="nav-label"/>
                        </HBox>
                    </graphic>
                    <tooltip><Tooltip text="Module 6"/></tooltip>
                </Button>
            </VBox>

            <Pane styleClass="sidebar-sep"/>

            <Label text="SYSTEME" styleClass="sidebar-section-label">
                <VBox.margin><Insets left="20" top="10" bottom="4"/></VBox.margin>
            </Label>

            <VBox alignment="TOP_LEFT" spacing="4" styleClass="sidebar-bottom">
                <Button fx:id="themeToggleBtn" styleClass="nav-btn" maxWidth="Infinity"
                        alignment="BASELINE_LEFT">
                    <graphic>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label fx:id="themeIcon" text="L" styleClass="nav-icon"/>
                            <Label fx:id="themeLabel" text="Mode Jour / Nuit" styleClass="nav-label"/>
                        </HBox>
                    </graphic>
                    <tooltip><Tooltip text="Changer le theme"/></tooltip>
                </Button>
                <Button fx:id="logoutBtn" styleClass="nav-btn" maxWidth="Infinity"
                        alignment="BASELINE_LEFT">
                    <graphic>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label text="X" styleClass="nav-icon nav-icon-logout"/>
                            <Label text="Deconnexion" styleClass="nav-label nav-label-logout"/>
                        </HBox>
                    </graphic>
                    <tooltip><Tooltip text="Deconnexion"/></tooltip>
                </Button>
            </VBox>
        </VBox>

        <VBox HBox.hgrow="ALWAYS" styleClass="main-content" spacing="0">
            <HBox fx:id="headerBar" styleClass="header-bar" alignment="CENTER_LEFT" spacing="16">
                <Button fx:id="hamburgerBtn" text="☰" styleClass="hamburger-btn"/>
                <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                    <Text fx:id="headerTitle" text="Dashboard" styleClass="header-title"/>
                    <Text fx:id="headerSubtitle" text="Module pret pour integration" styleClass="header-subtitle"/>
                </VBox>
                <HBox alignment="CENTER_RIGHT" spacing="12" styleClass="header-profile">
                    <VBox alignment="CENTER_RIGHT" spacing="1">
                        <Label fx:id="adminNameLabel" text="Utilisateur" styleClass="admin-name"/>
                        <Label fx:id="adminRoleLabel" text="" styleClass="admin-role"/>
                    </VBox>
                    <Button fx:id="notifBtn" text="N" styleClass="header-action-btn"/>
                    <Button fx:id="cartBtn" text="C" styleClass="header-action-btn"/>
                    <MenuButton fx:id="profileMenu" text="Profil" styleClass="profile-menu-btn">
                        <items>
                            <MenuItem fx:id="editProfileItem" text="Modifier profil"/>
                            <MenuItem fx:id="paymentHistoryItem" text="Historique de paiement"/>
                            <SeparatorMenuItem/>
                            <MenuItem fx:id="logoutProfileItem" text="Deconnexion"/>
                        </items>
                    </MenuButton>
                    <StackPane fx:id="adminAvatarWrap" styleClass="admin-avatar-wrap"
                               prefWidth="42" prefHeight="42" maxWidth="42" maxHeight="42">
                        <ImageView fx:id="adminAvatar" fitWidth="38" fitHeight="38" preserveRatio="false"/>
                        <Label fx:id="adminAvatarLetter" text="U" styleClass="admin-avatar-letter"/>
                    </StackPane>
                </HBox>
            </HBox>

            <StackPane fx:id="contentContainer" styleClass="content-area" VBox.vgrow="ALWAYS"/>
        </VBox>
    </HBox>

    <StackPane fx:id="profileOverlayPane" visible="false" managed="false"
               AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0"
               AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
               styleClass="overlay-bg">

        <VBox fx:id="profileDetailCard" styleClass="detail-card" maxWidth="540" maxHeight="640"
              alignment="TOP_CENTER" spacing="16">

            <HBox alignment="CENTER_RIGHT" styleClass="detail-header-row">
                <Text fx:id="profileDetailTitle" text="Modifier mon profil" styleClass="detail-title" HBox.hgrow="ALWAYS"/>
                <Button fx:id="profileCloseDetailBtn" text="X" styleClass="close-detail-btn"/>
            </HBox>

            <StackPane styleClass="detail-avatar-wrap" prefWidth="80" prefHeight="80"
                       maxWidth="80" maxHeight="80">
                <ImageView fx:id="profileDetailAvatar" fitWidth="76" fitHeight="76" preserveRatio="false"/>
                <Label fx:id="profileDetailAvatarLetter" text="" styleClass="detail-avatar-letter"/>
            </StackPane>

            <VBox spacing="10" styleClass="detail-fields">
                <HBox spacing="10">
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="NOM" styleClass="detail-field-label"/>
                        <TextField fx:id="profileDetailNom" styleClass="detail-field-input"/>
                    </VBox>
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="PRENOM" styleClass="detail-field-label"/>
                        <TextField fx:id="profileDetailPrenom" styleClass="detail-field-input"/>
                    </VBox>
                </HBox>
                <VBox spacing="2">
                    <Label text="EMAIL" styleClass="detail-field-label"/>
                    <TextField fx:id="profileDetailEmail" styleClass="detail-field-input"/>
                </VBox>
                <HBox spacing="10">
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="TELEPHONE" styleClass="detail-field-label"/>
                        <TextField fx:id="profileDetailTel" styleClass="detail-field-input"/>
                    </VBox>
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="DATE DE NAISSANCE" styleClass="detail-field-label"/>
                        <TextField fx:id="profileDetailDate" styleClass="detail-field-input"/>
                    </VBox>
                </HBox>
                <HBox spacing="10">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="ROLE" styleClass="detail-field-label"/>
                        <ComboBox fx:id="profileDetailRole" styleClass="detail-combo" maxWidth="Infinity" disable="true"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="STATUT" styleClass="detail-field-label"/>
                        <ComboBox fx:id="profileDetailStatus" styleClass="detail-combo" maxWidth="Infinity" disable="true"/>
                    </VBox>
                </HBox>
            </VBox>

            <HBox spacing="10" alignment="CENTER" styleClass="detail-actions">
                <Button fx:id="profileDetailSaveBtn" text="Sauvegarder" styleClass="detail-save-btn"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button fx:id="profileDetailCancelBtn" text="Annuler" styleClass="detail-cancel-btn"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>

            <Label fx:id="profileDetailMessage" text="" managed="false" visible="false"
                   wrapText="true" maxWidth="Infinity" styleClass="detail-message"/>
        </VBox>
    </StackPane>
</AnchorPane>
